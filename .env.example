# Server
PORT=5000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_here

# Database (SQLite path)
DB_PATH=./barbershop.db

# Africa's Talking SMS (https://africastalking.com)
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=your_africastalking_username
AT_SENDER_ID=BarberShop

# Chapa Payment Gateway (https://chapa.co)
CHAPA_SECRET_KEY=CHASECK_TEST-your_chapa_secret_key
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-your_chapa_public_key
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret

# Frontend URL (for redirects)
CLIENT_URL=http://localhost:5173
