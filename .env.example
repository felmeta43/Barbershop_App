# Server
PORT=5000
NODE_ENV=production
JWT_SECRET=change_this_to_a_long_random_string

# ─────────────────────────────────────────────
# Firebase (Firestore + FCM push notifications)
# Get these from Firebase Console → Project Settings
# ─────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Client-side Firebase config (prefix with VITE_ for Vite to expose them)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abc123def456
# VAPID key from Firebase Console → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=BNtq...

# Africa's Talking SMS (https://africastalking.com)
AT_API_KEY=your_api_key_here
AT_USERNAME=your_username_here
# AT_SENDER_ID=BarberShop   # Only set if you have a registered sender ID

# Chapa Payment Gateway (https://chapa.co)
# Use CHASECK_TEST-... keys for testing, CHASECK-... for live
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxx
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxxxxxxxxxx

# URLs — set these to your actual IP/domain so Chapa redirects work
CLIENT_URL=http://localhost:5000
SERVER_URL=http://localhost:5000
